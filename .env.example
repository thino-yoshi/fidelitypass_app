# ── Configuration Flutter — Qarta App ─────────────────────────────────────────
#
# Ce projet Flutter n'utilise pas de fichier .env classique.
# Les configurations requises sont les suivantes :
#
# 1. FIREBASE (Android)
#    Fichier : android/app/google-services.json
#    Source  : Firebase Console > Project Settings > Your apps > Android
#
# 2. FIREBASE (iOS)
#    Fichier : ios/Runner/GoogleService-Info.plist
#    Source  : Firebase Console > Project Settings > Your apps > iOS
#
# 3. URL API BACKEND
#    Fichier : lib/config/api.dart
#    Valeur  : const String apiUrl = 'https://fidelitypass-production.up.railway.app';
#    → Changer cette URL pour pointer vers votre propre backend en dev/staging
#
# 4. GOOGLE SIGN-IN (Android)
#    Le SHA-1 de votre app doit être enregistré dans Firebase Console
#    Commande : keytool -list -v -keystore ~/.android/debug.keystore -alias androiddebugkey -storepass android -keypass android
